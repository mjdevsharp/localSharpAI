# OpenTelemetry Environment Configuration

# OTel Exporter Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Service Identification
OTEL_SERVICE_NAME=LocalSharpAi.Api
OTEL_SERVICE_VERSION=1.0.0
OTEL_DEPLOYMENT_ENVIRONMENT=development

# Sampling Configuration (0.0 to 1.0)
# 1.0 = 100% sampling (development)
# 0.1 = 10% sampling (production)
# 0.0 = 0% sampling (disabled)
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0

# Logging Configuration
OTEL_LOG_LEVEL=info

# Metrics Configuration
OTEL_METRICS_ENABLED=true

# Resource Attributes
OTEL_RESOURCE_ATTRIBUTES=service.namespace=localsharpai,service.instance.id=localhost
